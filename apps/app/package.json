{
  "name": "@singsong/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "scripts": {
    "//install": "Windows 로컬 설치는 반드시 install:local. 이유는 docs/WINDOWS_INSTALL.md",
    "install:local": "npm install --ignore-scripts",
    "start": "expo start --dev-client",
    "start:go": "expo start --go",
    "doctor": "npx expo-doctor",
    "lint": "expo lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "export:android": "expo export --platform android --output-dir dist/android",
    "preflight:release": "node tools/release-preflight.mjs",
    "eas-build-post-install": "node tools/eas-build-preflight.mjs",
    "verify": "npm run lint && npm run typecheck && npm run doctor && expo install --check && npm run export:android"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.6.2",
    "@singsong/domain": "file:../../packages/domain",
    "@singsong/store": "file:../../packages/store",
    "@singsong/ticket-art": "file:../../packages/ticket-art",
    "@singsong/tokens": "file:../../packages/tokens",
    "expo": "~57.0.8",
    "expo-build-properties": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.9",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-manipulator": "~57.0.6",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-media-library": "~57.0.3",
    "expo-router": "~57.0.8",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "~57.0.10",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@emnapi/core": "2.0.0-alpha.3",
    "@emnapi/runtime": "2.0.0-alpha.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3",
    "vitest": "4.1.10"
  }
}
